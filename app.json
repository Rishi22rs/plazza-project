{
  "expo": {
    "name": "Plazza",
    "slug": "plazza-project",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/plazza-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF0099",
        "foregroundImage": "./assets/plazza-adaptive-foreground.png",
        "monochromeImage": "./assets/plazza-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rishi22rs.plazza",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/plazza-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "plazza-takehome"
  }
}
